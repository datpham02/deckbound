[gd_scene format=3]

[ext_resource type="Theme" path="res://themes/placeholder_theme.tres" id="1_theme"]

[node name="CardCompact" type="Button"]
custom_minimum_size = Vector2(260, 290)
theme = ExtResource("1_theme")
theme_type_variation = &"CardButton"

[node name="Margin" type="MarginContainer" parent="."]
mouse_filter = 2
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 14
theme_override_constants/margin_top = 8
theme_override_constants/margin_right = 14
theme_override_constants/margin_bottom = 8

[node name="Rows" type="VBoxContainer" parent="Margin"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 2

[node name="Header" type="HBoxContainer" parent="Margin/Rows"]
layout_mode = 2
mouse_filter = 2

[node name="Cost" type="Label" parent="Margin/Rows/Header"]
custom_minimum_size = Vector2(56, 0)
layout_mode = 2
theme_type_variation = &"CardNameLabel"
text = "2"

[node name="Name" type="Label" parent="Margin/Rows/Header"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"CardNameLabel"
text = "Quill Jab"
clip_text = true

[node name="PlayLine" type="Label" parent="Margin/Rows"]
layout_mode = 2
theme_type_variation = &"CardLabel"
text = "Deal 6 damage"
